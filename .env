# ─────────────────────────────────────────────────────────────────────────────
# Krampus — environment variables
# Copy this file to .env and fill in the values before running.
#
#   cp .env.example .env
#
# docker-compose overrides POSTGRES_DSN, REDIS_ADDR, KAFKA_BROKERS, and
# AWS_ENDPOINT automatically to point at container names; the values here
# are used when running the app directly on the host.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENV=development
HTTP_PORT=:8080
NODE_ID=node-1

# ── Security ─────────────────────────────────────────────────────────────────
# Must be overridden in production — use a 32+ character random string.
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=krampus
POSTGRES_USER=krampus
POSTGRES_PASSWORD=krampus_pass
POSTGRES_DSN=postgres://krampus:krampus_pass@localhost:5432/krampus?sslmode=disable

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPICS_INCOMING=incoming
KAFKA_TOPICS_VALIDATED=validated
KAFKA_TOPICS_SAVED=saved
KAFKA_TOPICS_BROADCAST=broadcast

# ── S3 / MinIO ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BUCKET=krampus-media
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Point at localhost when running the app on the host; docker-compose
# overrides this to http://minio:9000 for container-to-container traffic.
AWS_ENDPOINT=http://localhost:9000

# ── File storage ─────────────────────────────────────────────────────────────
FILE_BASE_PATH=./storage
FILE_SEGMENT_SIZE=1h
FILE_BUFFER_SIZE=64MB
FILE_FLUSH_TIMEOUT=100ms

# ── Call / WebRTC signaling ──────────────────────────────────────────────────
# Presence TTL: how long a call peer stays registered between heartbeats.
CALL_PRESENCE_TTL=30s
# Hard cap on peers per call room.
CALL_MAX_PEERS=8
# Comma-separated STUN server URLs surfaced to clients via /api/v1/chat/call/ice-servers.
STUN_SERVERS=stun:stun.l.google.com:19302
# Optional TURN server (leave blank to disable).
TURN_URL=
TURN_USER=
TURN_PASS=

# ── Observability (optional) ─────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
